[Unit]
Description=HIDS synthetic dashboard session pilot (no real data)
Requires=hids-dashboard-pilot-http.socket hids-dashboard-pilot-control.socket
After=hids-dashboard-pilot-http.socket hids-dashboard-pilot-control.socket
[Service]
Type=simple
User=hids-ingest
Group=hids-ingest
SupplementaryGroups=
WorkingDirectory=/opt/hids-dashboard-pilot/code
ExecStart=/opt/hids-dashboard-pilot/venv/bin/python3 -I -B -c 'import sys; sys.path.insert(0,"/opt/hids-dashboard-pilot/code"); from api.pilot_service import main; raise SystemExit(main())'
Sockets=hids-dashboard-pilot-http.socket hids-dashboard-pilot-control.socket
Restart=no
RuntimeMaxSec=30min
TimeoutStopSec=8
KillMode=control-group
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
InaccessiblePaths=-/var/lib/hids -/run/hids/m3
MemoryMax=256M
TasksMax=32
StandardOutput=null
StandardError=journal
