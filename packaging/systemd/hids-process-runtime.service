[Unit]
Description=HIDS explicitly authorized process lifecycle runtime
[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/hids-process-pipeline/code
ExecStart=/usr/bin/python3 -I -B -c 'import sys; sys.path.insert(0,"/opt/hids-process-pipeline/code"); from engine.ingestion.process_control import main; raise SystemExit(main())'
Restart=no
KillMode=mixed
TimeoutStopSec=15
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/var/lib/hids/m3 -/var/lib/hids/m4 -/run/hids/m3
ReadWritePaths=/run/hids/process /run/hids/process-backend
MemoryMax=256M
TasksMax=32
StandardOutput=null
StandardError=null
# No Install section: a root-created one-use grant is required on every start.
