[Unit]
Description=HIDS bounded stored-history trial
Requires=hids-dashboard-history-http.socket hids-dashboard-history-control.socket
After=hids-dashboard-history-http.socket hids-dashboard-history-control.socket
[Service]
Type=simple
User=hids-ingest
Group=hids-ingest
SupplementaryGroups=
WorkingDirectory=/opt/hids-dashboard-history/code
ExecStart=/opt/hids-dashboard-history/venv/bin/python3 -I -B -c 'import sys; sys.path.insert(0,"/opt/hids-dashboard-history/code"); from api.history_service import main; raise SystemExit(main())'
Sockets=hids-dashboard-history-http.socket hids-dashboard-history-control.socket
Restart=no
RuntimeMaxSec=10min
TimeoutStopSec=8
KillMode=control-group
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
TemporaryFileSystem=/var/lib/hids:ro
BindReadOnlyPaths=/var/lib/hids/m4/store
InaccessiblePaths=-/run/hids/m3
MemoryMax=256M
TasksMax=32
StandardOutput=null
StandardError=journal
